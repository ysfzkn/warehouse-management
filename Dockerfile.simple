# Simple single-stage build for Railway
FROM maven:3.9.9-eclipse-temurin-17-alpine

WORKDIR /app

# Copy everything
COPY pom.xml .
COPY src ./src

# Build
RUN mvn clean package -DskipTests -q

# Expose port
EXPOSE 8080

# Run
CMD ["java", "-XX:+UseContainerSupport", "-XX:MaxRAMPercentage=75.0", "-jar", "target/warehouse-management-1.0.0.jar"]

