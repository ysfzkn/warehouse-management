# ===== Database =====
DATABASE_URL=jdbc:postgresql://localhost:5432/warehouse_db
DB_USERNAME=warehouse_user
DB_PASSWORD=your_secure_password_here

# ===== Application =====
SPRING_PROFILES_ACTIVE=dev
PORT=8080

# ===== Admin Credentials (CHANGE IN PRODUCTION) =====
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=change_this_strong_password
ADMIN_SECURITY_CODE=change_this_code

# ===== JWT Security =====
JWT_SECRET=generate_a_random_64_char_string_here

# ===== Payment - iyzico =====
PAYMENT_PROVIDER=IYZICO
PAYMENT_SANDBOX=true
IYZICO_API_KEY=your_iyzico_api_key
IYZICO_SECRET_KEY=your_iyzico_secret_key
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
IYZICO_CALLBACK_URL=https://yourdomain.com/api/store/payment/callback
IYZICO_TIMEOUT_MINUTES=15

# ===== Payment - Bank Transfer =====
BANK_TRANSFER_DEADLINE_HOURS=48
BANK_TRANSFER_BANK_NAME=Your Bank Name
BANK_TRANSFER_IBAN=TR00 0000 0000 0000 0000 0000 00
BANK_TRANSFER_ACCOUNT_HOLDER=Company Name Ltd.

# ===== Google OAuth =====
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://yourdomain.com/auth/google/callback

# ===== File Storage =====
PHOTO_STORAGE_DIR=uploads/shipments
IMPORT_STORAGE_DIR=uploads/stock-imports
