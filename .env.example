# ═══════════════════════════════════════════════════════════════
# ENVIRONMENT VARIABLES — .env.example
# Bu dosyayı .env olarak kopyalayın ve değerleri doldurun.
# ⚠ .env dosyası ASLA git'e commit edilmemelidir!
# ═══════════════════════════════════════════════════════════════

# ── Profil ──
SPRING_PROFILES_ACTIVE=dev           # dev | prod

# ── Veritabanı ──
DATABASE_URL=jdbc:postgresql://localhost:5432/stock_management
DB_USERNAME=postgres
DB_PASSWORD=your-strong-db-password

# ── Sunucu ──
PORT=8080

# ── Admin Kimlik Bilgileri ──
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=change-this-strong-password
ADMIN_SECURITY_CODE=change-this-security-code

# ── JWT (en az 32 karakter, rastgele üretilmiş) ──
# openssl rand -base64 48
JWT_SECRET=generate-a-random-64-char-string-here-use-openssl-rand
JWT_EXPIRATION_HOURS=8

# ── Kolon şifreleme anahtarı (TC kimlik no, ödeme gateway sırları) ──
# openssl rand -base64 32
# Boş bırakılırsa JWT_SECRET'tan türetilir; ayrı anahtar önerilir.
APP_ENCRYPTION_KEY=

# ── Host allowlist (PRODUCTION'DA ZORUNLU) ──
# Admin endpoint'leri sadece bu host'tan çağrılabilir. Tanımlanmazsa mağaza
# domaininde bulunan bir XSS /api/admin/** çağırabilir hâle gelir.
APP_HOSTS_ADMIN=admin.example.com
APP_HOSTS_STORE=example.com,www.example.com

# ── Proxy zinciri ──
# İstemci IP'si Tomcat RemoteIpValve ile çözülür; sadece aşağıdaki aralıklardan
# gelen hop'lara güvenilir. Cloudflare gibi ek bir proxy varsa onun aralığını da
# ekleyin (regex, | ile ayrılmış).
# SERVER_TOMCAT_REMOTEIP_INTERNAL_PROXIES=10\.\d{1,3}\.\d{1,3}\.\d{1,3}|...
#
# Valve'ın sınıflandıramadığı fazladan bir proxy varsa güvenilir hop sayısını verin.
# 0 = ek işlem yok (varsayılan, önerilen).
TRUSTED_PROXY_COUNT=0
# /api/** için IP başına dakikalık üst sınır. 0 = kapalı.
RATELIMIT_GLOBAL_PER_MINUTE=600

# ── CAPTCHA ──
# Provider'a ulaşılamazsa istek reddedilir (fail-closed). true yaparsanız
# provider çöktüğünde CAPTCHA tamamen devre dışı kalır — önerilmez.
CAPTCHA_ENABLED=true
CAPTCHA_PROVIDER=hcaptcha
CAPTCHA_SECRET=
CAPTCHA_FAIL_OPEN=false
REFRESH_TOKEN_EXPIRATION_DAYS=30

# ── Base URL (frontend domain) ──
APP_BASE_URL=http://localhost:3000   # Production: https://www.siteniz.com

# ── CORS (virgülle ayrılmış izinli domain'ler) ──
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# ── E-posta / SMTP ──
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password   # Gmail > Güvenlik > Uygulama Şifreleri
MAIL_FROM=noreply@siteniz.com
MAIL_ENABLED=true

# ── Google OAuth 2.0 ──
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# ── Ödeme: iyzico ──
PAYMENT_PROVIDER=IYZICO
PAYMENT_SANDBOX=true                 # Production: false
IYZICO_API_KEY=sandbox-xxxxxxxxxxxxx
IYZICO_SECRET_KEY=sandbox-xxxxxxxxxxxxx
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com  # Production: https://api.iyzipay.com
IYZICO_CALLBACK_URL=http://localhost:8080/api/store/payment/callback
IYZICO_TIMEOUT_MINUTES=15

# ── Ödeme: Havale/EFT ──
BANK_TRANSFER_DEADLINE_HOURS=48
BANK_TRANSFER_BANK_NAME=Garanti BBVA
BANK_TRANSFER_IBAN=TR00 0000 0000 0000 0000 0000 00
BANK_TRANSFER_ACCOUNT_HOLDER=Firma Adi Ltd. Sti.

# ── Dosya Depolama ──
PHOTO_STORAGE_DIR=uploads/shipments            # Production: /data/uploads/shipments
IMPORT_STORAGE_DIR=uploads/stock-imports        # Production: /data/uploads/imports
