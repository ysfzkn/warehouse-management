    {
      "name": "5 - Etiket",
      "item": [
        {
          "name": "Barkod / Etiket (base64 PDF)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/shipments/{{shipment_id}}/barcode?format=pdf&packageContentVisibility=true&warningVisibility=true&integratedOrderNoVisibility=true",
              "host": ["{{base_url}}"],
              "path": ["shipments", "{{shipment_id}}", "barcode"],
              "query": [
                {
                  "key": "format",
                  "value": "pdf",
                  "description": "pdf desteklenir"
                },
                {
                  "key": "packageContentVisibility",
                  "value": "true",
                  "description": "Koli icerigi etikette gorunsun mu"
                },
                {
                  "key": "warningVisibility",
                  "value": "true",
                  "description": "Uyari metinleri basilsin mi"
                },
                {
                  "key": "integratedOrderNoVisibility",
                  "value": "true",
                  "description": "Entegre siparis no basilsin mi"
                }
              ]
